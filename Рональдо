<!doctype html><html lang="ru"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><title>Змейка — 40 яблок</title><style>
*{box-sizing:border-box}body{margin:0;background:#0b1219;color:#f2f6fa;font:16px system-ui,sans-serif;display:flex;justify-content:center}main{width:min(100%,680px);padding:14px;display:flex;flex-direction:column;gap:12px}.top{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.stats{display:flex;gap:14px;font-weight:700}.levels{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.levels button,button{color:white;background:#253544;border:1px solid #526575;border-radius:12px;padding:12px 8px;font-weight:700;font-size:14px}.levels button.active{outline:2px solid #61ef87;background:#14502f}canvas{width:100%;height:auto;aspect-ratio:1;border:3px solid #43ef83;border-radius:12px;background:#08151a;touch-action:none}.controls{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;max-width:310px;width:100%;align-self:center}.controls button{font-size:25px;padding:12px}.actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.msg{text-align:center;min-height:24px;color:#ccebd7}small{color:#aabac6;text-align:center}
</style><main><div class="top"><h2 style="margin:0">🐍 Змейка</h2><div class="stats"><span>🍎 <b id="score">0</b>/40</span><span>🏆 Рекорд: <b id="best">0</b></span></div></div><div class="levels"><button data-level="easy" class="active">🟢 ЛЕГКО</button><button data-level="medium">🟡 СРЕДНЕ</button><button data-level="hard">💀 НЕВОЗМОЖНО</button></div><canvas id="game" width="480" height="480" aria-label="Игровое поле змейки"></canvas><div class="msg" id="msg">Выбери сложность и нажми «Старт»</div><div class="actions"><button id="start">▶ СТАРТ</button><button id="reset">↻ ЗАНОВО</button></div><div class="controls"><span></span><button data-dir="0,-1">⬆️</button><span></span><button data-dir="-1,0">⬅️</button><button id="pause">⏸️</button><button data-dir="1,0">➡️</button><span></span><button data-dir="0,1">⬇️</button><span></span></div><small>Стрелки / WASD или свайпы по полю. Съешь 40 яблок и не врежься в стену или хвост!</small></main><script src="https://telegram.org/js/telegram-web-app.js"></script>
<script>
if (window.Telegram && window.Telegram.WebApp) {
  Telegram.WebApp.ready();
  Telegram.WebApp.expand();
}
</script>
<script>
(()=>{const $=id=>document.getElementById(id),cv=$('game'),ctx=cv.getContext('2d'),N=20,C=24,speeds={easy:190,medium:105,hard:42};let level='easy',snake,dir,next,apple,score=0,best=0,running=false,paused=false,ended=false,timer=null;function reset(){clearInterval(timer);timer=null;snake=[{x:5,y:10},{x:4,y:10},{x:3,y:10}];dir={x:1,y:0};next={...dir};score=0;running=false;paused=false;ended=false;spawn();update();$('msg').textContent='Выбери сложность и нажми «Старт»';draw()}function spawn(){let spots=[];for(let y=0;y<N;y++)for(let x=0;x<N;x++)if(!snake.some(p=>p.x===x&&p.y===y))spots.push({x,y});apple=spots[Math.floor(Math.random()*spots.length)]}function update(){$('score').textContent=score;$('best').textContent=best}function draw(){ctx.fillStyle='#08151a';ctx.fillRect(0,0,480,480);ctx.strokeStyle='#1a3038';ctx.lineWidth=1;for(let i=0;i<=N;i++){ctx.beginPath();ctx.moveTo(i*C,0);ctx.lineTo(i*C,480);ctx.stroke();ctx.beginPath();ctx.moveTo(0,i*C);ctx.lineTo(480,i*C);ctx.stroke()}ctx.fillStyle='#ff304b';ctx.beginPath();ctx.arc(apple.x*C+12,apple.y*C+13,9,0,Math.PI*2);ctx.fill();ctx.fillStyle='#6bff35';ctx.fillRect(apple.x*C+12,apple.y*C+2,4,7);snake.forEach((p,i)=>{ctx.fillStyle=i===0?'#c0ff63':'#48d879';ctx.beginPath();ctx.roundRect(p.x*C+2,p.y*C+2,C-4,C-4,6);ctx.fill()});if(!running||paused||ended){ctx.fillStyle='rgba(0,0,0,.72)';ctx.fillRect(35,202,410,76);ctx.fillStyle='#fff';ctx.textAlign='center';ctx.font='bold 25px system-ui';ctx.fillText(score>=40?'🏆 ПОБЕДА!':ended?'ИГРА ОКОНЧЕНА':paused?'ПАУЗА':'ГОТОВ?',240,235);ctx.font='16px system-ui';ctx.fillText(score>=40?'40 ЯБЛОКОВ СОБРАНО':ended?`Счёт: ${score}/40`:'Нажми «Старт»',240,260)}}function finish(win){running=false;ended=true;clearInterval(timer);timer=null;$('msg').textContent=win?'🏆 Ты победил! 40 яблок!':`💀 Конец игры — ${score}/40`;draw()}function tick(){if(!running||paused)return;dir={...next};const h={x:snake[0].x+dir.x,y:snake[0].y+dir.y},eat=h.x===apple.x&&h.y===apple.y;if(h.x<0||h.x>=N||h.y<0||h.y>=N||snake.some((p,i)=>i<(eat?snake.length:snake.length-1)&&p.x===h.x&&p.y===h.y)){finish(false);return}snake.unshift(h);if(eat){score++;best=Math.max(best,score);update();if(score>=40){finish(true);return}spawn()}else snake.pop();draw()}function start(){if(ended)reset();running=true;paused=false;clearInterval(timer);timer=setInterval(tick,speeds[level]);$('msg').textContent='Вперёд! Цель — 40 яблок 🍎';draw()}function turn(x,y){if(x===-dir.x&&y===-dir.y)return;next={x,y}}document.querySelectorAll('[data-level]').forEach(b=>b.onclick=()=>{level=b.dataset.level;document.querySelectorAll('[data-level]').forEach(q=>q.classList.toggle('active',q===b));reset();$('msg').textContent='Сложность выбрана. Жми «Старт»'});document.querySelectorAll('[data-dir]').forEach(b=>b.onclick=()=>turn(...b.dataset.dir.split(',').map(Number)));$('start').onclick=start;$('reset').onclick=reset;$('pause').onclick=()=>{if(!running)return;paused=!paused;$('msg').textContent=paused?'⏸ Пауза':'Продолжай!';draw()};document.addEventListener('keydown',e=>{const m={ArrowUp:[0,-1],w:[0,-1],ArrowDown:[0,1],s:[0,1],ArrowLeft:[-1,0],a:[-1,0],ArrowRight:[1,0],d:[1,0]};if(m[e.key]){e.preventDefault();turn(...m[e.key])}});let sx=0,sy=0;cv.addEventListener('pointerdown',e=>{sx=e.clientX;sy=e.clientY});cv.addEventListener('pointerup',e=>{let dx=e.clientX-sx,dy=e.clientY-sy;if(Math.max(Math.abs(dx),Math.abs(dy))>18){if(Math.abs(dx)>Math.abs(dy))turn(dx>0?1:-1,0);else turn(0,dy>0?1:-1)}});reset()})();
</script></html>
